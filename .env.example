# Copy to .env.local and fill in. .env.local is gitignored.

# Public site origin, used for metadata, sitemap and RSS.
# Set this in the Vercel project settings for production.
NEXT_PUBLIC_SITE_URL=

# Supabase project (login + article comments).
# Both of these are published to the browser by design.
# Use the PUBLISHABLE key (sb_publishable_...), never the service_role key:
# service_role bypasses row-level security, which is this app's entire
# security model.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
